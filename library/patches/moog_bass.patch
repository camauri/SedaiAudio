# MINIMOOG — il basso. Tre oscillatori, il filtro a 24 dB/ottava, e
# l'inviluppo sul taglio che e' dove sta davvero il suono.
#
# La pendenza: il nostro filter e' un Chamberlin a 12 dB/ottava (misurati
# 13), la scala del Moog ne fa 24. Due in cascata danno 25 misurati, ed e'
# per questo che ce ne sono due e non uno.
module note = note
module gl   = glide time=0.006

# 32' + 16' scordato + 32' quadra: la ricetta del basso
module osc1 = osc shape=saw    freq=55
module osc2 = osc shape=saw    freq=55
module osc3 = osc shape=square freq=27.5

module f1   = filter mode=lowpass cutoff=230 res=0.62
module f2   = filter mode=lowpass cutoff=230 res=0.30
module fenv = env a=0.001 d=0.34 s=0.10 r=0.12
module aenv = env a=0.002 d=0.60 s=0.55 r=0.14
module amp  = amp
module drv  = sdist drive=1.6 tone=0.45

connect note.pitch -> gl.in
connect gl.out -> osc1.pitch
connect gl.out -> osc2.pitch
connect gl.out -> osc3.pitch
set osc2.pitch = 0.0026          # ~4.5 cent sopra: il battimento e' il corpo

connect osc1.out -> f1.in amount=0.42
connect osc2.out -> f1.in amount=0.38
connect osc3.out -> f1.in amount=0.30

connect note.gate -> fenv.gate
connect note.gate -> aenv.gate
connect fenv.out -> f1.cutoff amount=2.30    # il "contour amount"
connect fenv.out -> f2.cutoff amount=2.30
connect f1.out -> f2.in

# un filo di saturazione: lo stadio d'uscita del Moog scaldava
set drv.mix   = 0.35
connect f2.out -> drv.in
connect drv.out -> amp.in
connect aenv.out -> amp.gain amount=0.26
output amp.out
