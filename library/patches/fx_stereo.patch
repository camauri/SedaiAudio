# Effetto stereo con UNA unita' stereo, non due mono affiancate.
# Il riverbero di SAF e' stereo dentro: gli si danno due canali e se ne
# riprendono due, con la sua immagine intatta.
module l  = input channel=0
module r  = input channel=1
module rv = sreverb size=0.72 damping=0.35
set rv.mix = 0.30
connect l.out -> rv.in
connect r.out -> rv.inR
output rv.out
output rv.outR
