# Un componente, non uno strumento: labbra, tubo, campana e inviluppi.
# NON dichiara uscite — quelle sono di chi lo include. Usato da brass.patch
# (lo strumento asciutto) e da brass_room.patch (lo stesso, in una stanza).
#
module note = note
module brs  = brass bell=0.5 lipq=8 drive=10
module env  = env a=0.06 d=0.25 s=0.85 r=0.35
module amp  = amp

# Il fiato E' l'inviluppo. Messo a zero perche' l'inviluppo lo fornisca per
# intero: sotto la soglia non oscilla affatto, quindi la nota comincia
# quando l'aria ARRIVA — ed e' per questo che un attacco d'ottone suona
# cosi'. Un fade non lo fa: c'e' un bordo.
set brs.press = 0.0
connect env.out -> brs.press  amount=2.3

# L'imboccatura. A riposo larga e tonda; la velocity la STRINGE, e labbra
# strette sbattono ogni ciclo — e' li' che nasce lo squillo. Quindi
# l'ampiezza e' negativa: piu' forte suoni, meno sono aperte.
set brs.open = 0.62
connect note.vel -> brs.open  amount=-0.36

# Il soffio. Non e' aria della stanza: e' del MUSICISTA, ed e' anche cosi' che
# due strumenti si distinguono. Piano si perde piu' aria in proporzione al
# suono, quindi la velocity lo TOGLIE — ampiezza negativa, come per le labbra.
#
# 1.2 = circa -34 dB sotto il suono, SCELTO A ORECCHIO e provvisorio. Misure
# fatte: la registrazione di trombone porta lo 0.9% della potenza fuori dalle
# armoniche, ma l'84% di quell'energia e' fruscio di sala, non fiato — quindi
# il bersaglio misurato resta piu' alto di quanto un ascoltatore accetti su una
# nota sola e asciutta. Delle due l'una, e la misura non sa dire quale: o la
# stima e' sporca, o un suono sintetico solo tollera meno rumore di quanto ne
# contenga una registrazione. Qui decide l'orecchio, e lo dice il numero
# accanto.
#
# ⚠️ La velocity SOTTRAE: sotto una base di 0.6 le note forti perdono il soffio
# di colpo invece di scalarlo. A questo valore non succede, ma se lo abbassi,
# quella sottrazione va cambiata in un rapporto.
set brs.breath = 1.2
connect note.vel -> brs.breath  amount=-0.6

connect note.pitch -> brs.pitch
connect note.gate  -> brs.gate
connect note.gate  -> env.gate

connect brs.out  -> amp.in
connect env.out  -> amp.gain  amount=0.9
