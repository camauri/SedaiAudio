'' ============================================================================
'' saf.bas — describe a SAF instrument in SedaiBasic MODERN, and print a .patch.
'' 
'' GENERATED by patch_bas --lib. Do not edit: it is produced by building every
'' module in the registry and asking it what ports it has, so it cannot
'' describe an engine that does not exist. Regenerate after adding a module.
'' 
'' THE CONTRACT IS TEXT. This library knows nothing about SAF: it records what
'' was declared and prints it. SAF knows nothing about SedaiBasic: it reads a
'' .patch, which is what it already read. Neither project links the other.
'' 
'' Modules are held as POINTERS. That is not a workaround for the VM's trouble
'' with arrays of composite objects inside a Type: an array declared As Osc
'' could not hold a Saw either, so anything polymorphic wants pointers anyway.
'' ============================================================================

Const SAF_MAX_MOD  As Integer = 256
Const SAF_MAX_SET  As Integer = 512
Const SAF_MAX_LINK As Integer = 1024
Const SAF_MAX_OUT  As Integer = 16

Dim Shared As String  safModName(0 To 255)
Dim Shared As String  safModType(0 To 255)
Dim Shared As String  safModKeys(0 To 255)
Dim Shared As Integer safModN

Dim Shared As String  safSetPath(0 To 511)
Dim Shared As Double  safSetVal(0 To 511)
Dim Shared As Integer safSetN

Dim Shared As String  safLinkSrc(0 To 1023)
Dim Shared As String  safLinkDst(0 To 1023)
Dim Shared As Double  safLinkAmt(0 To 1023)
Dim Shared As Integer safLinkNorm(0 To 1023)
Dim Shared As Integer safLinkN

Dim Shared As String  safIncFile(0 To 31)
Dim Shared As String  safIncPrefix(0 To 31)
Dim Shared As String  safIncHash(0 To 31)
Dim Shared As Integer safIncN

Dim Shared As String  safOutPath(0 To 15)
Dim Shared As Double  safOutPos(0 To 15)
Dim Shared As Integer safOutHasPos(0 To 15)
Dim Shared As Integer safOutN
Dim Shared As Double  safExtent
Dim Shared As Integer safVoices
Dim Shared As String  safTitle

Function SafDeclare(nm As String, ty As String) As Integer
  safModName(safModN) = nm
  safModType(safModN) = ty
  safModKeys(safModN) = ""
  safModN = safModN + 1
  Return safModN - 1
End Function

Sub SafSet(path As String, v As Double)
  safSetPath(safSetN) = path
  safSetVal(safSetN) = v
  safSetN = safSetN + 1
End Sub

Sub SafLink(src As String, dst As String, amount As Double, normalled As Integer)
  safLinkSrc(safLinkN) = src
  safLinkDst(safLinkN) = dst
  safLinkAmt(safLinkN) = amount
  safLinkNorm(safLinkN) = normalled
  safLinkN = safLinkN + 1
End Sub

'' An included file brings in modules under a prefix. They are NOT declared
'' here — the engine reads the other file — so the objects that stand for
'' them are Bind-ed rather than Init-ed.
Sub SafInclude(file As String, prefix As String, hash As String)
  safIncFile(safIncN) = file
  safIncPrefix(safIncN) = prefix
  safIncHash(safIncN) = hash
  safIncN = safIncN + 1
End Sub

Sub SafOutput(path As String)
  safOutPath(safOutN) = path
  safOutHasPos(safOutN) = 0
  safOutN = safOutN + 1
End Sub

Sub SafOutputAt(path As String, atPos As Double)
  safOutPath(safOutN) = path
  safOutPos(safOutN) = atPos
  safOutHasPos(safOutN) = 1
  safOutN = safOutN + 1
End Sub

'' The one mechanism: a port is a knob plus any number of sources, summed.
Type Port
  Public:
    Path As String
    Declare Sub Add(ByRef src As Port, amount As Double = 1.0)
    Declare Sub AddNormalled(ByRef src As Port, amount As Double = 1.0)
    Declare Property Value() As Double
    Declare Property Value(v As Double)
  Private:
    Knob As Double
End Type

Sub Port.Add(ByRef src As Port, amount As Double = 1.0)
  SafLink(src.Path, This.Path, amount, 0)
End Sub

Sub Port.AddNormalled(ByRef src As Port, amount As Double = 1.0)
  SafLink(src.Path, This.Path, amount, 1)
End Sub

Property Port.Value() As Double
  Return This.Knob
End Property

Property Port.Value(v As Double)
  This.Knob = v
  SafSet(This.Path, v)
End Property

'' Every module knows its own name, so nothing anywhere spells "osc1.pitch".
Type Module Extends Object
  Public:
    Nm  As String
    Idx As Integer
    Out As Port
    Declare Sub Key(k As String, v As String)
    Declare Sub KeyN(k As String, v As Double)
End Type

'' Idx = -1 means "declared somewhere else", i.e. bound to an included
'' module. Its keys belong to the file that declares it, so they are
'' refused here rather than written into a slot that is not ours.
Sub Module.Key(k As String, v As String)
  If This.Idx >= 0 Then
    safModKeys(This.Idx) = safModKeys(This.Idx) + " " + k + "=" + v
  End If
End Sub

Sub Module.KeyN(k As String, v As Double)
  If This.Idx >= 0 Then
    safModKeys(This.Idx) = safModKeys(This.Idx) + " " + k + "=" + Str(v)
  End If
End Sub

