'' Printing. One place, at the end, so declarations may come in any order.
Sub SafEmit()
  Dim As Integer i
  If safTitle <> "" Then Print "# " + safTitle
  Print "# Generated from SedaiBasic MODERN. Do not edit: edit the .bas."
  If safVoices > 0 Then
    Print ""
    Print "voices " + Str(safVoices)
  End If
  Print ""
  For i = 0 To safModN - 1
    Print "module " + safModName(i) + " = " + safModType(i) + safModKeys(i)
  Next
  If safSetN > 0 Then Print ""
  For i = 0 To safSetN - 1
    Print "set " + safSetPath(i) + " = " + Str(safSetVal(i))
  Next
  Print ""
  For i = 0 To safLinkN - 1
    Dim As String s
    s = "connect " + safLinkSrc(i) + " -> " + safLinkDst(i)
    If safLinkAmt(i) <> 1.0 Then s = s + " amount=" + Str(safLinkAmt(i))
    If safLinkNorm(i) = 1 Then s = s + " normalled"
    Print s
  Next
  Print ""
  For i = 0 To safOutN - 1
    Dim As String o
    o = "output " + safOutPath(i)
    If safOutHasPos(i) = 1 Then o = o + " pos=" + Str(safOutPos(i))
    If (i = 0) And (safExtent > 0.0) Then o = o + " extent=" + Str(safExtent)
    Print o
  Next
End Sub
